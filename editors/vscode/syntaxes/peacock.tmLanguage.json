{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Peacock",
  "scopeName": "source.peacock",
  "fileTypes": [
    "सूत्र"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#capabilities"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#reserved"
    },
    {
      "include": "#contextuals"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#methods"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.peacock",
          "match": "//.*$"
        },
        {
          "name": "comment.block.peacock",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(कार्य)(?![\\p{L}\\p{M}\\p{N}_])\\s+([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.peacock"
            },
            "2": {
              "name": "entity.name.function.peacock"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(प्रतिमान|अभ्यास|संघटन)(?![\\p{L}\\p{M}\\p{N}_])\\s+([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.peacock"
            },
            "2": {
              "name": "entity.name.type.peacock"
            }
          }
        }
      ]
    },
    "capabilities": {
      "patterns": [
        {
          "name": "meta.capability.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(अधिकार)(?![\\p{L}\\p{M}\\p{N}_])\\s+(?<![\\p{L}\\p{M}\\p{N}_])(दृश्य|सञ्चय|गणना)(?![\\p{L}\\p{M}\\p{N}_])",
          "captures": {
            "1": {
              "name": "storage.modifier.capability.peacock"
            },
            "2": {
              "name": "support.constant.capability.peacock"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:विच्छिन्दु|प्रत्यानय|अनुवर्तय|निश्चिनु|अन्यथा|क्षिप|गृह्ण|प्रति|मध्ये|यावत्|यत्न|यदि)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "keyword.other.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:परिवर्तनीय|प्रतिमान|अधिकार|अभ्यास|प्रकरण|स्थापय|उपयोग|कार्य|रूपेण|संघटन|तथा|वा|न)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "reserved": {
      "patterns": [
        {
          "name": "keyword.other.reserved.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:कार्यान्वयन|असामकालिक|प्रतीक्षा|सार्वजनिक|उत्पादय|सूचीभेद|मिलान|स्थिर|आयात|जनय)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "contextuals": {
      "patterns": [
        {
          "name": "support.constant.contextual.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:उद्देश्य|अधिगमदर|अनुकूलक|आवृत्ति|सक्रियण|समूहमान|एककानि|निर्गम|निवेश|क्रम|बीज|सघन)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:अक्षरमाला|पूर्णाङ्क|सत्यता|दशमलव|अभाव|सर्व|एकक)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "support.type.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:प्रतिमानप्रकार|पूर्णाङ्क३२|दत्तसमूह|चित्रपट|दशमलव३२|दशमलव६४|आयाम|वर्ण|सीमा|सूची)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:असत्य|सत्य)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "name": "support.namespace.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:तन्त्रजाल|प्रक्रिया|चित्र|पाठ्य|सञ्चय|गणित|रङ्ग|गति)(?![\\p{L}\\p{M}\\p{N}_])(?=\\s*\\.)"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:दशमलवीकरण|पाठ्यीकरण|पूर्णीकरण|प्रकारनाम|आयामीकरण|निरपेक्ष|दैर्घ्य|मुद्रय|विह्वल|परिसर)(?![\\p{L}\\p{M}\\p{N}_])(?=\\s*\\()"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.peacock",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.peacock",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])\\p{Nd}[\\p{Nd}_]*(?:\\.\\p{Nd}[\\p{Nd}_]+)?(?:[eE][+-]?\\p{Nd}[\\p{Nd}_]+)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.numeric.float.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])\\p{Nd}[\\p{Nd}_]*\\.\\p{Nd}[\\p{Nd}_]*(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.numeric.integer.peacock",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\p{Nd}[\\p{Nd}_]*)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "methods": {
      "patterns": [
        {
          "name": "meta.method-call.peacock",
          "match": "(?<=\\.)([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.method.peacock"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.peacock",
          "match": "\\*\\*|==|!=|<=|>=|->|\\+=|-=|\\*=|/=|%=|\\.\\.|[-+*/%<>=]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.peacock",
          "match": "[(),;?]"
        },
        {
          "name": "punctuation.accessor.peacock",
          "match": "\\."
        },
        {
          "name": "punctuation.section.peacock",
          "match": "[{}\\[\\]]"
        },
        {
          "name": "punctuation.definition.peacock",
          "match": ":"
        }
      ]
    }
  }
}
