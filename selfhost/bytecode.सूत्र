    bc_push_slot(b, operand);
    bc_len(b);
    bc_store_slot(b, dest);
}
कार्य bc_on_assert(b: BCBuilder, cond: पूर्णाङ्क, msg_slot: पूर्णाङ्क) {
    bc_push_slot(b, cond);
    यदि msg_slot >= ० {
        bc_push_slot(b, msg_slot);
        bc_assert(b, १);
    } अन्यथा {
        bc_push_const(b, "null");
        bc_assert(b, ०);
    }
}
कार्य bc_on_throw(b: BCBuilder, mulya: पूर्णाङ्क) {
    bc_push_slot(b, mulya);
    bc_throw(b);
}
कार्य bc_on_jump(b: BCBuilder, chihna: अक्षरमाला) {
    bc_jump(b, chihna);
}
कार्य bc_on_branch(b: BCBuilder, cond: पूर्णाङ्क, then_label: अक्षरमाला, else_label: अक्षरमाला) {
    bc_push_slot(b, cond);
    bc_jump_if_false(b, else_label);
    bc_jump(b, then_label);
}
कार्य bc_on_return(b: BCBuilder, mulya: पूर्णाङ्क) {
    यदि mulya >= ० {
        bc_push_slot(b, mulya);
        bc_ret(b, १);
    } अन्यथा {
        bc_ret(b, ०);
    }
}
कार्य bc_on_try_begin(b: BCBuilder, catch_chihna: अक्षरमाला) {
    bc_try_begin(b, catch_chihna);
}
कार्य bc_on_try_end(b: BCBuilder) -> अक्षरमाला {
    प्रत्यानय bc_try_end(b);
}
कार्य bc_on_catch(b: BCBuilder, dest: पूर्णाङ्क) {
    bc_catch_store(b, dest);
}
कार्य bc_on_finally_begin(b: BCBuilder, chihna: अक्षरमाला) {
    bc_finally_begin(b, chihna);
}
कार्य bc_on_finally_end(b: BCBuilder, chihna: अक्षरमाला) -> अक्षरमाला {
    प्रत्यानय bc_finally_end(b, chihna);
}
कार्य bc_on_finally_resume(b: BCBuilder) {
    bc_finally_resume(b);
}
कार्य bc_on_label(b: BCBuilder, chihna: अक्षरमाला) -> अक्षरमाला {
    प्रत्यानय bc_label(b, chihna);
}
कार्य bc_on_nop(b: BCBuilder) {
    bc_nop(b);
}
कार्य bc_resolve_patches(b: BCBuilder) -> अक्षरमाला {
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(b.patch_idx) {
        स्थापय idx = b.patch_idx.प्राप्नु(i);
        स्थापय argpos = b.patch_arg.प्राप्नु(i);
        स्थापय chihna = b.patch_label.प्राप्नु(i);
        स्थापय लक्ष्य = bc_find_label(b, chihna);
        यदि लक्ष्य < ० {
            प्रत्यानय "unknown label '" + chihna + "'";
        }
        यदि argpos == ० {
            b.संकेत.प्राप्नु(idx).arg0 = पाठ्यीकरण(लक्ष्य);
        } अन्यथा यदि argpos == १ {
            b.संकेत.प्राप्नु(idx).arg1 = पाठ्यीकरण(लक्ष्य);
        } अन्यथा {
            b.संकेत.प्राप्नु(idx).arg2 = पाठ्यीकरण(लक्ष्य);
        }
        i += १;
    }
    यदि दैर्घ्य(b.try_stack) != ० {
        प्रत्यानय "unclosed try_begin";
    }
    यदि दैर्घ्य(b.finally_stack) != ० {
        प्रत्यानय "unclosed finally_begin";
    }
    प्रत्यानय "";
}
कार्य bc_builder_finish(b: BCBuilder) -> BCFunction {
    स्थापय err = bc_resolve_patches(b);
    यदि err != "" {
        bc_emit_raw(b, "NOP", "", "", "");
    }
    यदि दैर्घ्य(b.संकेत) == ० {
        bc_emit_raw(b, "RET", "0", "", "");
    }
    प्रत्यानय BCFunction(b.नाम, b.arity, b.slots, b.return_type_key, b.caps_repr, b.संकेत);
}
कार्य bc_escape(s: अक्षरमाला) -> अक्षरमाला {
    स्थापय परिवर्तनीय t = s.प्रतिस्थापय("\\", "\\\\");
    t = t.प्रतिस्थापय("\"", "\\\"");
    t = t.प्रतिस्थापय("\n", "\\n");
    t = t.प्रतिस्थापय("\r", "\\r");
    t = t.प्रतिस्थापय("\t", "\\t");
    प्रत्यानय t;
}
कार्य bc_instr_digest(instr: BCInstr) -> अक्षरमाला {
    स्थापय परिवर्तनीय out = "(" + instr.op;
    यदि instr.arg0 != "" {
        out = out + " " + instr.arg0;
    }
    यदि instr.arg1 != "" {
        out = out + " " + instr.arg1;
    }
    यदि instr.arg2 != "" {
        out = out + " " + instr.arg2;
    }
    प्रत्यानय out + ")";
}
कार्य bc_function_digest(kary: BCFunction) -> अक्षरमाला {
    स्थापय परिवर्तनीय out = "(fn " + kary.नाम + " arity=" + पाठ्यीकरण(kary.arity) + " slots=" + पाठ्यीकरण(kary.slots) + " ret=" + kary.return_type_key;
    यदि kary.caps_repr != "" {
        out = out + " caps=" + kary.caps_repr;
    }
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(kary.संकेत) {
        out = out + "\n  " + bc_instr_digest(kary.संकेत.प्राप्नु(i));
        i += १;
    }
    प्रत्यानय out + "\n)";
}
कार्य bc_module_digest(mod: BCModule) -> अक्षरमाला {
    स्थापय परिवर्तनीय out = "(module " + mod.नाम;
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(mod.uses) {
        out = out + " (use " + mod.uses.प्राप्नु(i) + ")";
        i += १;
    }
    out = out + ")";
    स्थापय परिवर्तनीय j = ०;
    यावत् j < दैर्घ्य(mod.functions) {
        out = out + "\n" + bc_function_digest(mod.functions.प्राप्नु(j));
        j += १;
    }
    स्थापय परिवर्तनीय k = ०;
    यावत् k < दैर्घ्य(mod.struct_descs) {
        out = out + "\n" + mod.struct_descs.प्राप्नु(k);
        k += १;
    }
    प्रत्यानय out;
}
कार्य bc_verify_function(kary: BCFunction) -> अक्षरमाला {
    यदि kary.slots < kary.arity {
        प्रत्यानय "slots < arity";
    }
    यदि दैर्घ्य(kary.संकेत) == ० {
        प्रत्यानय "no code";
    }
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(kary.संकेत) {
        स्थापय instr = kary.संकेत.प्राप्नु(i);
        यदि instr.op == "PUSH_SLOT" वा instr.op == "STORE_SLOT" {
            स्थापय s = parse_int(instr.arg0);
            यदि s < ० वा s >= kary.slots {
                प्रत्यानय "slot out of range at " + पाठ्यीकरण(i);
            }
        }
        यदि instr.op == "JUMP" वा instr.op == "JUMP_IF_FALSE" वा instr.op == "FINALLY_END" {
            स्थापय p = parse_int(instr.arg0);
            यदि p < ० वा p >= दैर्घ्य(kary.संकेत) {
                प्रत्यानय "jump target invalid at " + पाठ्यीकरण(i);
            }
        }
        यदि instr.op == "TRY_BEGIN" वा instr.op == "FINALLY_BEGIN" {
            स्थापय p = parse_int(instr.arg0);
            यदि p < ० वा p >= दैर्घ्य(kary.संकेत) {
                प्रत्यानय "catch target invalid at " + पाठ्यीकरण(i);
            }
        }
        i += १;
    }
    प्रत्यानय "";
}
कार्य bc_run_builtin_checks() -> पूर्णाङ्क {
    स्थापय परिवर्तनीय cases = ०;
    स्थापय b1 = new_bc_builder("alpha", ०, १, "पूर्णाङ्क", "");
    bc_on_const(b1, ०, "42");
    bc_on_return(b1, ०);
    स्थापय kary1 = bc_builder_finish(b1);
    निश्चिनु(दैर्घ्य(kary1.संकेत) == ४);
    निश्चिनु(kary1.संकेत.प्राप्नु(०).op == "PUSH_CONST");
    निश्चिनु(kary1.संकेत.प्राप्नु(३).op == "RET");
    निश्चिनु(bc_verify_function(kary1) == "");
    cases += १;
    स्थापय b2 = new_bc_builder("beta", २, ४, "पूर्णाङ्क", "");
    bc_on_binop(b2, २, "+", ०, १);
    bc_on_return(b2, २);
    स्थापय kary2 = bc_builder_finish(b2);
    निश्चिनु(kary2.संकेत.प्राप्नु(२).op == "BINOP");
    निश्चिनु(bc_verify_function(kary2) == "");
    cases += १;
    स्थापय b3 = new_bc_builder("branchy", ०, ३, "पूर्णाङ्क", "");
    bc_on_const(b3, ०, "true");
    bc_on_branch(b3, ०, "then", "else");
    bc_on_label(b3, "then");
    bc_on_const(b3, १, "1");
    bc_on_jump(b3, "endif");
    bc_on_label(b3, "else");
    bc_on_const(b3, २, "2");
    bc_on_jump(b3, "endif");
    bc_on_label(b3, "endif");
    bc_on_return(b3, १);
    स्थापय kary3 = bc_builder_finish(b3);
    निश्चिनु(bc_verify_function(kary3) == "");
    स्थापय jif = kary3.संकेत.प्राप्नु(३);
    निश्चिनु(jif.op == "JUMP_IF_FALSE");
    cases += १;
    स्थापय b4 = new_bc_builder("misc", ०, ५, "एकक", "");
    bc_on_const(b4, ०, "1");
    bc_on_const(b4, १, "2");
    स्थापय args4: सूची<पूर्णाङ्क> = [];
    args4.योजय(०);
    args4.योजय(१);
    bc_on_make_list(b4, २, args4);
    स्थापय args4b: सूची<पूर्णाङ्क> = [];
    args4b.योजय(२);
    bc_on_call(b4, ३, "मुद्रय", args4b);
    bc_on_return(b4, -१);
    स्थापय kary4 = bc_builder_finish(b4);
    निश्चिनु(bc_verify_function(kary4) == "");
    cases += १;
    स्थापय b5 = new_bc_builder("trying", ०, २, "एकक", "");
    bc_on_try_begin(b5, "handler");
    bc_on_const(b5, ०, "1");
    bc_on_try_end(b5);
    bc_on_jump(b5, "done");
    bc_on_label(b5, "handler");
    bc_on_catch(b5, १);
    bc_on_label(b5, "done");
    bc_on_return(b5, -१);
    स्थापय kary5 = bc_builder_finish(b5);
    निश्चिनु(bc_verify_function(kary5) == "");
    cases += १;
    स्थापय b6 = new_bc_builder("final", ०, १, "एकक", "");
    bc_on_finally_begin(b6, "fin");
    bc_on_const(b6, ०, "5");
    bc_on_finally_end(b6, "after");
    bc_on_label(b6, "fin");
    bc_on_finally_resume(b6);
    bc_on_label(b6, "after");
    bc_on_return(b6, -१);
    स्थापय kary6 = bc_builder_finish(b6);
    निश्चिनु(bc_verify_function(kary6) == "");
    cases += १;
    स्थापय mod = new_bc_module("demo");
    bc_module_add_use(mod, "गणना");
    bc_module_add_function(mod, kary1);
    bc_module_add_function(mod, kary2);
    स्थापय d = bc_module_digest(mod);
    निश्चिनु(d != "");
    cases += १;
    स्थापय b8 = new_bc_builder("fields", १, ४, "पूर्णाङ्क", "");
    bc_on_field_get(b8, १, ०, "x|struct_field");
    bc_on_len(b8, २, १);
    bc_on_assert(b8, २, -१);
    bc_on_return(b8, २);
    स्थापय kary8 = bc_builder_finish(b8);
    निश्चिनु(bc_verify_function(kary8) == "");
    cases += १;
    प्रत्यानय cases;
}
कार्य मुख्य() -> एकक {
    स्थापय checks = bc_run_builtin_checks();
    मुद्रय("PEACOCK bytecode checks passed (" + पाठ्यीकरण(checks) + " assertions)");
}
