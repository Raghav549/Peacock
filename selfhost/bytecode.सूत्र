    bc_store_slot(b, dest);
}
कार्य bc_on_struct_new(b: BCBuilder, dest: पूर्णाङ्क, struct_नाम: अक्षरमाला, तर्कावली: सूची<पूर्णाङ्क>) {
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(तर्कावली) {
        bc_push_slot(b, तर्कावली.प्राप्नु(i));
        i += १;
    }
    bc_struct_new(b, struct_नाम, दैर्घ्य(तर्कावली));
