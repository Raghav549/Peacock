}
कार्य bc_struct_new(b: BCBuilder, struct_नाम: अक्षरमाला, argc: पूर्णाङ्क) {
    bc_emit_raw(b, "STRUCT_NEW", struct_नाम, पाठ्यीकरण(argc), "");
}
कार्य bc_field_get(b: BCBuilder, field: अक्षरमाला, kind: अक्षरमाला) {
    bc_emit_raw(b, "FIELD_GET", field, kind, "");
}
कार्य bc_field_set(b: BCBuilder, field: अक्षरमाला) {
    bc_emit_raw(b, "FIELD_SET", field, "", "");
}
कार्य bc_index_get(b: BCBuilder) {
    bc_emit_raw(b, "INDEX_GET", "", "", "");
}
कार्य bc_index_set(b: BCBuilder) {
    bc_emit_raw(b, "INDEX_SET", "", "", "");
}
कार्य bc_make_list(b: BCBuilder, argc: पूर्णाङ्क) {
    bc_emit_raw(b, "MAKE_LIST", पाठ्यीकरण(argc), "", "");
}
कार्य bc_make_range(b: BCBuilder) {
    bc_emit_raw(b, "MAKE_RANGE", "", "", "");
}
कार्य bc_len(b: BCBuilder) {
    bc_emit_raw(b, "LEN", "", "", "");
}
कार्य bc_assert(b: BCBuilder, has_msg: पूर्णाङ्क) {
    bc_emit_raw(b, "ASSERT", पाठ्यीकरण(has_msg), "", "");
}
कार्य bc_throw(b: BCBuilder) {
    bc_emit_raw(b, "THROW", "", "", "");
}
कार्य bc_jump(b: BCBuilder, chihna: अक्षरमाला) {
    bc_emit_patched(b, "JUMP", chihna, "");
}
कार्य bc_jump_if_false(b: BCBuilder, chihna: अक्षरमाला) {
    bc_emit_patched(b, "JUMP_IF_FALSE", chihna, "");
}
कार्य bc_ret(b: BCBuilder, has_val: पूर्णाङ्क) {
    bc_emit_raw(b, "RET", पाठ्यीकरण(has_val), "", "");
}
कार्य bc_try_begin(b: BCBuilder, catch_label: अक्षरमाला) {
    स्थापय idx = bc_emit_raw(b, "TRY_BEGIN", "@", "-1", "");
    b.patch_idx.योजय(idx);
    b.patch_arg.योजय(०);
    b.patch_label.योजय(catch_label);
    b.try_stack.योजय(idx);
    b.try_catch_label.योजय(catch_label);
}
कार्य bc_try_end(b: BCBuilder) -> अक्षरमाला {
    यदि दैर्घ्य(b.try_stack) == ० {
        प्रत्यानय "try_end without try_begin";
    }
    स्थापय begin_idx = b.try_stack.प्राप्नु(दैर्घ्य(b.try_stack) - १);
    b.try_stack.निष्कासय();
    b.try_catch_label.निष्कासय();
    b.संकेत.प्राप्नु(begin_idx).arg1 = पाठ्यीकरण(दैर्घ्य(b.संकेत));
    bc_emit_raw(b, "TRY_END", "", "", "");
    प्रत्यानय "";
}
कार्य bc_catch(b: BCBuilder) {
    bc_emit_raw(b, "CATCH", "", "", "");
}
कार्य bc_catch_store(b: BCBuilder, slot: पूर्णाङ्क) {
    bc_catch(b);
    bc_store_slot(b, slot);
}
कार्य bc_finally_begin(b: BCBuilder, chihna: अक्षरमाला) {
    स्थापय idx = bc_emit_raw(b, "FINALLY_BEGIN", "@", "-1", "");
    b.patch_idx.योजय(idx);
    b.patch_arg.योजय(०);
    b.patch_label.योजय(chihna);
    b.finally_stack.योजय(idx);
}
कार्य bc_finally_end(b: BCBuilder, chihna: अक्षरमाला) -> अक्षरमाला {
    यदि दैर्घ्य(b.finally_stack) == ० {
        प्रत्यानय "finally_end without finally_begin";
    }
    स्थापय begin_idx = b.finally_stack.प्राप्नु(दैर्घ्य(b.finally_stack) - १);
    b.finally_stack.निष्कासय();
    b.संकेत.प्राप्नु(begin_idx).arg1 = पाठ्यीकरण(दैर्घ्य(b.संकेत));
    स्थापय idx = bc_emit_raw(b, "FINALLY_END", "@", "", "");
    b.patch_idx.योजय(idx);
    b.patch_arg.योजय(०);
    b.patch_label.योजय(chihna);
    प्रत्यानय "";
}
कार्य bc_finally_resume(b: BCBuilder) {
    bc_emit_raw(b, "FINALLY_RESUME", "", "", "");
}
कार्य bc_label(b: BCBuilder, chihna: अक्षरमाला) -> अक्षरमाला {
    यदि bc_find_label(b, chihna) >= ० {
        प्रत्यानय "duplicate label '" + chihna + "'";
    }
    b.label_keys.योजय(chihna);
    b.label_vals.योजय(दैर्घ्य(b.संकेत));
    प्रत्यानय "";
}
कार्य bc_nop(b: BCBuilder) {
    bc_emit_raw(b, "NOP", "", "", "");
}
कार्य parse_int(s: अक्षरमाला) -> पूर्णाङ्क {
    यदि s == "" वा s == "null" {
        प्रत्यानय ०;
    }
    स्थापय परिवर्तनीय neg = असत्य;
    स्थापय परिवर्तनीय आरम्भ = ०;
    यदि पाठ्य.अक्षरम्(s, ०) == "-" {
        neg = सत्य;
        आरम्भ = १;
    }
    स्थापय परिवर्तनीय val = ०;
    स्थापय परिवर्तनीय i = आरम्भ;
    यावत् i < दैर्घ्य(s) {
        स्थापय ch = पाठ्य.अक्षरम्(s, i);
        यदि पाठ्य.अङ्कः(ch) {
            स्थापय digit = पाठ्य.अक्षरसङ्ख्या(ch) - पाठ्य.अक्षरसङ्ख्या("0");
            val = val * १० + digit;
        } अन्यथा {
            विच्छिन्दु;
        }
        i += १;
    }
    यदि neg {
        val = -val;
    }
    प्रत्यानय val;
}
कार्य bc_on_const(b: BCBuilder, dest: पूर्णाङ्क, value_repr: अक्षरमाला) {
    bc_push_const(b, value_repr);
    bc_store_slot(b, dest);
}
कार्य bc_on_slot_get(b: BCBuilder, dest: पूर्णाङ्क, slot: पूर्णाङ्क) {
    bc_push_slot(b, slot);
    bc_store_slot(b, dest);
}
कार्य bc_on_slot_set(b: BCBuilder, लक्ष्य_slot: पूर्णाङ्क, src: पूर्णाङ्क) {
    bc_push_slot(b, src);
    bc_store_slot(b, लक्ष्य_slot);
}
कार्य bc_on_move(b: BCBuilder, dest: पूर्णाङ्क, src: पूर्णाङ्क) {
    bc_push_slot(b, src);
    bc_store_slot(b, dest);
}
कार्य bc_on_binop(b: BCBuilder, dest: पूर्णाङ्क, op: अक्षरमाला, left: पूर्णाङ्क, right: पूर्णाङ्क) {
    bc_push_slot(b, left);
    bc_push_slot(b, right);
    bc_binop(b, op);
    bc_store_slot(b, dest);
}
कार्य bc_on_unop(b: BCBuilder, dest: पूर्णाङ्क, op: अक्षरमाला, operand: पूर्णाङ्क) {
    bc_push_slot(b, operand);
    bc_unop(b, op);
    bc_store_slot(b, dest);
}
कार्य bc_on_call(b: BCBuilder, dest: पूर्णाङ्क, callee: अक्षरमाला, तर्कावली: सूची<पूर्णाङ्क>) {
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(तर्कावली) {
        bc_push_slot(b, तर्कावली.प्राप्नु(i));
        i += १;
    }
    bc_call(b, callee, दैर्घ्य(तर्कावली));
    bc_store_slot(b, dest);
}
कार्य bc_on_call_native(b: BCBuilder, dest: पूर्णाङ्क, callee: अक्षरमाला, तर्कावली: सूची<पूर्णाङ्क>) {
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(तर्कावली) {
        bc_push_slot(b, तर्कावली.प्राप्नु(i));
        i += १;
    }
    bc_call_native(b, callee, दैर्घ्य(तर्कावली));
    bc_store_slot(b, dest);
}
कार्य bc_on_method(b: BCBuilder, dest: पूर्णाङ्क, method: अक्षरमाला, receiver: पूर्णाङ्क, तर्कावली: सूची<पूर्णाङ्क>) {
    bc_push_slot(b, receiver);
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(तर्कावली) {
        bc_push_slot(b, तर्कावली.प्राप्नु(i));
        i += १;
    }
    bc_method(b, method, १ + दैर्घ्य(तर्कावली));
    bc_store_slot(b, dest);
}
कार्य bc_on_model_init(b: BCBuilder, dest: पूर्णाङ्क, model_नाम: अक्षरमाला, तर्कावली: सूची<पूर्णाङ्क>) {
