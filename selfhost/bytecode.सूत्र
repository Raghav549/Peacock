कार्य bc_on_field_get(b: BCBuilder, dest: पूर्णाङ्क, आधार: पूर्णाङ्क, field: अक्षरमाला) {
    bc_push_slot(b, आधार);
    स्थापय परिवर्तनीय kind = "struct_field";
    स्थापय परिवर्तनीय fname = field;
    स्थापय parts = field.विभाजय("|");
    यदि दैर्घ्य(parts) == २ {
        fname = parts.प्राप्नु(०);
        kind = parts.प्राप्नु(१);
    }
    bc_field_get(b, fname, kind);
    bc_store_slot(b, dest);
}
कार्य bc_on_field_set(b: BCBuilder, आधार: पूर्णाङ्क, field: अक्षरमाला, mulya: पूर्णाङ्क) {
    bc_push_slot(b, आधार);
    bc_push_slot(b, mulya);
    bc_field_set(b, field);
}
कार्य bc_on_index_get(b: BCBuilder, dest: पूर्णाङ्क, आधार: पूर्णाङ्क, soochaka: पूर्णाङ्क) {
    bc_push_slot(b, आधार);
    bc_push_slot(b, soochaka);
    bc_index_get(b);
