// PEACOCK-native bytecode compiler (migration stage 5).
प्रकरण selfhost_bytecode
उपयोग पाठ्य;
संघटन BCInstr {
    op: अक्षरमाला,
    arg0: अक्षरमाला,
    arg1: अक्षरमाला,
    arg2: अक्षरमाला
}
संघटन BCFunction {
    नाम: अक्षरमाला,
    arity: पूर्णाङ्क,
    slots: पूर्णाङ्क,
    return_type_key: अक्षरमाला,
    caps_repr: अक्षरमाला,
    संकेत: सूची<BCInstr>
}
संघटन BCModule {
    नाम: अक्षरमाला,
    uses: सूची<अक्षरमाला>,
    functions: सूची<BCFunction>,
    struct_descs: सूची<अक्षरमाला>
}
संघटन BCBuilder {
    नाम: अक्षरमाला,
    arity: पूर्णाङ्क,
    slots: पूर्णाङ्क,
    return_type_key: अक्षरमाला,
    caps_repr: अक्षरमाला,
    संकेत: सूची<BCInstr>,
    lines: सूची<अक्षरमाला>,
    label_keys: सूची<अक्षरमाला>,
    label_vals: सूची<पूर्णाङ्क>,
    patch_idx: सूची<पूर्णाङ्क>,
    patch_arg: सूची<पूर्णाङ्क>,
    patch_label: सूची<अक्षरमाला>,
    try_stack: सूची<पूर्णाङ्क>,
    try_catch_label: सूची<अक्षरमाला>,
    finally_stack: सूची<पूर्णाङ्क>
}
कार्य new_bc_module(नाम: अक्षरमाला) -> BCModule {
    प्रत्यानय BCModule(नाम, [], [], []);
}
कार्य bc_module_add_use(mod: BCModule, cap: अक्षरमाला) {
    mod.uses.योजय(cap);
}
कार्य bc_module_add_struct(mod: BCModule, desc: अक्षरमाला) {
    mod.struct_descs.योजय(desc);
}
कार्य bc_module_add_function(mod: BCModule, kary: BCFunction) {
    mod.functions.योजय(kary);
}
कार्य new_bc_builder(नाम: अक्षरमाला, arity: पूर्णाङ्क, slots: पूर्णाङ्क, return_type_key: अक्षरमाला, caps_repr: अक्षरमाला) -> BCBuilder {
    प्रत्यानय BCBuilder(नाम, arity, slots, return_type_key, caps_repr, [], [], [], [], [], [], [], [], [], []);
}
कार्य bc_find_label(b: BCBuilder, chihna: अक्षरमाला) -> पूर्णाङ्क {
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(b.label_keys) {
        यदि b.label_keys.प्राप्नु(i) == chihna {
            प्रत्यानय b.label_vals.प्राप्नु(i);
        }
        i += १;
    }
    प्रत्यानय -१;
}
कार्य bc_emit_raw(b: BCBuilder, op: अक्षरमाला, arg0: अक्षरमाला, arg1: अक्षरमाला, arg2: अक्षरमाला) -> पूर्णाङ्क {
    b.संकेत.योजय(BCInstr(op, arg0, arg1, arg2));
    b.lines.योजय("0:0");
    प्रत्यानय दैर्घ्य(b.संकेत) - १;
}
कार्य bc_emit_patched(b: BCBuilder, op: अक्षरमाला, chihna: अक्षरमाला, extra: अक्षरमाला) -> पूर्णाङ्क {
    स्थापय idx = bc_emit_raw(b, op, "@", extra, "");
    b.patch_idx.योजय(idx);
    b.patch_arg.योजय(०);
    b.patch_label.योजय(chihna);
    प्रत्यानय idx;
}
कार्य bc_push_const(b: BCBuilder, repr: अक्षरमाला) {
    bc_emit_raw(b, "PUSH_CONST", repr, "", "");
}
कार्य bc_push_slot(b: BCBuilder, slot: पूर्णाङ्क) {
    bc_emit_raw(b, "PUSH_SLOT", पाठ्यीकरण(slot), "", "");
}
कार्य bc_store_slot(b: BCBuilder, slot: पूर्णाङ्क) {
    bc_emit_raw(b, "STORE_SLOT", पाठ्यीकरण(slot), "", "");
}
कार्य bc_pop(b: BCBuilder) {
    bc_emit_raw(b, "POP", "", "", "");
}
कार्य bc_binop(b: BCBuilder, op: अक्षरमाला) {
    bc_emit_raw(b, "BINOP", op, "", "");
}
कार्य bc_unop(b: BCBuilder, op: अक्षरमाला) {
    bc_emit_raw(b, "UNOP", op, "", "");
}
कार्य bc_call(b: BCBuilder, callee: अक्षरमाला, argc: पूर्णाङ्क) {
    bc_emit_raw(b, "CALL", callee, पाठ्यीकरण(argc), "");
}
कार्य bc_call_native(b: BCBuilder, callee: अक्षरमाला, argc: पूर्णाङ्क) {
    bc_emit_raw(b, "CALL_NATIVE", callee, पाठ्यीकरण(argc), "");
