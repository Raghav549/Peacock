कार्य bc_on_index_set(b: BCBuilder, आधार: पूर्णाङ्क, soochaka: पूर्णाङ्क, mulya: पूर्णाङ्क) {
    bc_push_slot(b, आधार);
    bc_push_slot(b, soochaka);
    bc_push_slot(b, mulya);
