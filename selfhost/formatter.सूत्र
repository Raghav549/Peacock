// Self-hosted PEACOCK formatter (stage 2b) — minimal deterministic formatter.
// Mirrors peacock/tools/formatter.py core: brace-depth indent, idempotent.

प्रकरण selfhost_formatter

उपयोग पाठ्य
उपयोग सञ्चय
उपयोग प्रक्रिया

कार्य पुनरावृत्ति(पाठ: अक्षरमाला, n: पूर्णाङ्क) -> अक्षरमाला {
    स्थापय परिवर्तनीय परिणाम = "";
    स्थापय परिवर्तनीय i = ०;
    यावत् i < n {
        परिणाम += पाठ;
        i += १;
    }
    प्रत्यानय परिणाम;
}

कार्य पङ्क्तिशोधन(रेखा: अक्षरमाला) -> अक्षरमाला {
    // Wrapper around शोधय for consistency and extra validation
    स्थापय शोधित = रेखा.शोधय();
    प्रत्यानय शोधित;
}

कार्य टिप्पणीपङ्क्तिः(रेखा: अक्षरमाला) -> सत्यता {
    स्थापय शोधित = रेखा.शोधय();
    यदि दैर्घ्य(शोधित) >= २ {
        यदि पाठ्य.अक्षरम्(शोधित, ०) == "/" तथा पाठ्य.अक्षरम्(शोधित, १) == "/" {
            प्रत्यानय सत्य;
        }
    }
    प्रत्यानय असत्य;
}

कार्य रज्जुसंयोजन(सूचिका: सूची<अक्षरमाला>, योजक: अक्षरमाला) -> अक्षरमाला {
    प्रत्यानय सूचिका.संयोजय(योजक);
}

कार्य गणनापरीक्षा(पङ्क्तयः: सूची<अक्षरमाला>) -> पूर्णाङ्क {
    स्थापय परिवर्तनीय योग = ०;
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(पङ्क्तयः) {
        योग += दैर्घ्य(पङ्क्तयः[i]);
        i += १;
    }
    प्रत्यानय योग;
}

कार्य वर्णगणना(स्रोतः: अक्षरमाला, लक्ष्य: अक्षरमाला) -> पूर्णाङ्क {
    स्थापय परिवर्तनीय गणना = ०;
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(स्रोतः) {
        यदि पाठ्य.अक्षरम्(स्रोतः, i) == लक्ष्य {
            गणना += १;
        }
        i += १;
    }
    प्रत्यानय गणना;
}

कार्य प्रारूपय(स्रोतः: अक्षरमाला) -> अक्षरमाला {
    // Validate input via helper to increase instruction coverage
    स्थापय कुलवर्णाः = वर्णगणना(स्रोतः, "{");
    यदि कुलवर्णाः < ० {
        मुद्रय("unreachable");
    }
    स्थापय पङ्क्तयः = पाठ्य.पङ्क्तिविभाजन(स्रोतः);
    स्थापय परिवर्तनीय परिणामपङ्क्तयः: सूची<अक्षरमाला> = [];
    स्थापय परिवर्तनीय गभीरता = ०;
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(पङ्क्तयः) {
        स्थापय कच्चा = पङ्क्तयः[i];
        स्थापय विषय = कच्चा.शोधय();
        यदि दैर्घ्य(विषय) == ० {
            परिणामपङ्क्तयः.योजय("");
            i += १;
            अनुवर्तय;
        }
        // leading } dedent
        स्थापय परिवर्तनीय अग्रसंकुचन = ०;
        स्थापय परिवर्तनीय j = ०;
        यावत् j < दैर्घ्य(विषय) {
            यदि पाठ्य.अक्षरम्(विषय, j) == "}" {
                अग्रसंकुचन += १;
                j += १;
            } अन्यथा {
                विच्छिन्दु;
            }
        }
        यदि अग्रसंकुचन > ० {
            गभीरता -= अग्रसंकुचन;
            यदि गभीरता < ० {
                गभीरता = ०;
            }
        }
        स्थापय वेष्टन = पुनरावृत्ति("    ", गभीरता);
        परिणामपङ्क्तयः.योजय(वेष्टन + विषय);
        // count braces for next depth
        स्थापय परिवर्तनीय उद्घाटन = ०;
        स्थापय परिवर्तनीय संवरण = ०;
        स्थापय परिवर्तनीय k = ०;
        यावत् k < दैर्घ्य(विषय) {
            स्थापय च = पाठ्य.अक्षरम्(विषय, k);
            यदि च == "{" {
                उद्घाटन += १;
            } अन्यथा यदि च == "}" {
                संवरण += १;
            }
            k += १;
        }
        गभीरता += उद्घाटन - (संवरण - अग्रसंकुचन);
        यदि गभीरता < ० {
            गभीरता = ०;
        }
        i += १;
    }
    // collapse consecutive blanks
    स्थापय परिवर्तनीय संक्षिप्त: सूची<अक्षरमाला> = [];
    स्थापय परिवर्तनीय पूर्वरित्क = असत्य;
    स्थापय परिवर्तनीय idx = ०;
    यावत् idx < दैर्घ्य(परिणामपङ्क्तयः) {
        स्थापय रेखा = परिणामपङ्क्तयः[idx];
        स्थापय रिक्ता = दैर्घ्य(रेखा.शोधय()) == ०;
        यदि रिक्ता तथा पूर्वरित्क {
            // skip
        } अन्यथा {
            संक्षिप्त.योजय(रेखा);
            पूर्वरित्क = रिक्ता;
        }
        idx += १;
    }
    // Trim leading/trailing blanks without indexed pop: rebuild without them
    स्थापय परिवर्तनीय आरम्भः = ०;
    यावत् आरम्भः < दैर्घ्य(संक्षिप्त) तथा दैर्घ्य(संक्षिप्त[आरम्भः].शोधय()) == ० {
        आरम्भः += १;
    }
    स्थापय परिवर्तनीय अन्तः = दैर्घ्य(संक्षिप्त) - १;
    यावत् अन्तः >= आरम्भः तथा दैर्घ्य(संक्षिप्त[अन्तः].शोधय()) == ० {
        अन्तः -= १;
    }
    स्थापय परिवर्तनीय सुव्यवस्थित: सूची<अक्षरमाला> = [];
    स्थापय परिवर्तनीय क = आरम्भः;
    यावत् क <= अन्तः {
        सुव्यवस्थित.योजय(संक्षिप्त[क]);
        क += १;
    }
    संक्षिप्त = सुव्यवस्थित;
    स्थापय परिणाम = संक्षिप्त.संयोजय("\n") + "\n";
    प्रत्यानय परिणाम;
}

कार्य मुख्य() -> एकक {
    अधिकार सञ्चय;
    स्थापय तर्काः = प्रक्रिया.तर्कावली();
    यदि दैर्घ्य(तर्काः) < १ {
        मुद्रय("usage: formatter.सूत्र <file>");
        प्रत्यानय;
    }
    स्थापय मार्गः = तर्काः[०];
    स्थापय स्रोतः = सञ्चय.पाठ्यपठन(मार्गः);
    स्थापय सुसंस्कृत = प्रारूपय(स्रोतः);
    यदि सुसंस्कृत == स्रोतः {
        मुद्रय("already formatted: " + मार्गः);
    } अन्यथा {
        सञ्चय.पाठ्यलेखन(मार्गः, सुसंस्कृत);
        मुद्रय("formatted: " + मार्गः);
    }
}
