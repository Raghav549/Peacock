// Full tensor/model coverage is staged; this kernel handles core
// string/list/canvas stubs with capability gates.

प्रकरण selfhost_native
उपयोग पाठ्य

संघटन NativeDesc {
    नाम: अक्षरमाला,
    क्षमता: अक्षरमाला
}

कार्य native_capability(नाम: अक्षरमाला) -> अक्षरमाला {
    यदि नाम == "मुद्रय" { प्रत्यानय ""; }
    यदि नाम == "पाठ्य.अक्षरम्" { प्रत्यानय ""; }
    यदि नाम == "पाठ्य.अङ्कः" { प्रत्यानय ""; }
    यदि नाम == "दैर्घ्य" { प्रत्यानय ""; }
    यदि नाम == "पाठ्यीकरण" { प्रत्यानय ""; }
    यदि नाम == "सञ्चय.पठ" { प्रत्यानय "सञ्चय"; }
    यदि नाम == "सञ्चय.लिख" { प्रत्यानय "सञ्चय"; }
    यदि नाम == "चित्र.प्रदर्शय" { प्रत्यानय "दृश्य"; }
    यदि नाम == "गणना.योग" { प्रत्यानय "गणना"; }
    प्रत्यानय "";
}

कार्य native_call_stub(नाम: अक्षरमाला, तर्कावली: सूची<अक्षरमाला>) -> अक्षरमाला {
    यदि नाम == "मुद्रय" {
        यदि दैर्घ्य(तर्कावली) != १ { क्षिप "मुद्रय expects 1 arg"; }
        // In PEACOCK VM, मुद्रय is host output; here we just return success marker
        प्रत्यानय "ok";
    }
    यदि नाम == "पाठ्य.अक्षरम्" {
        यदि दैर्घ्य(तर्कावली) != २ { क्षिप "अक्षरम् expects 2"; }
        स्थापय s = तर्कावली.प्राप्नु(०); स्थापय _idx = तर्कावली.प्राप्नु(१);
        // stub: return first char
        यदि दैर्घ्य(s) == ० { क्षिप "अक्षरम् out of bounds"; }
        प्रत्यानय पाठ्य.अक्षरम्(s, ०);
    }
    यदि नाम == "दैर्घ्य" {
        यदि दैर्घ्य(तर्कावली) != १ { क्षिप "दैर्घ्य expects 1"; }
        प्रत्यानय पाठ्यीकरण(दैर्घ्य(तर्कावली.प्राप्नु(०)));
    }
    क्षिप "unknown native " + नाम;
}

कार्य native_has_grant(अनुदानानि: सूची<अक्षरमाला>, क्षमता: अक्षरमाला) -> सत्यता {
    यदि क्षमता == "" { प्रत्यानय सत्य; }
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(अनुदानानि) {
        यदि अनुदानानि.प्राप्नु(i) == क्षमता { प्रत्यानय सत्य; }
        i += १;
    }
    प्रत्यानय असत्य;
}

कार्य native_require(अनुदानानि: सूची<अक्षरमाला>, नाम: अक्षरमाला) {
    स्थापय cap = native_capability(नाम);
    यदि cap != "" तथा न native_has_grant(अनुदानानि, cap) {
        क्षिप "host has not granted capability " + cap;
    }
}

कार्य native_run_checks() -> पूर्णाङ्क {
    स्थापय परिवर्तनीय cases = ०;
    निश्चिनु(native_capability("मुद्रय") == ""); cases += १;
    निश्चिनु(native_capability("सञ्चय.पठ") == "सञ्चय"); cases += १;
    स्थापय grants: सूची<अक्षरमाला> = ["सञ्चय"];
    निश्चिनु(native_has_grant(grants, "सञ्चय")); cases += १;
    निश्चिनु(native_has_grant(grants, "गणना") == असत्य); cases += १;
    native_require(grants, "सञ्चय.पठ"); cases += १;
    // negative: should throw when missing grant
    स्थापय परिवर्तनीय threw = असत्य;
    यत्न { native_require(grants, "चित्र.प्रदर्शय"); } गृह्ण (_e) { threw = सत्य; }
    निश्चिनु(threw); cases += १;
    प्रत्यानय cases;
}


