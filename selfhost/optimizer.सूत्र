// PEACOCK-native optimiser (migration stage 4c).
// Mirrors `peacock/compiler/optimizer.py`: constant folding, branch folding,
// unreachable elimination, jump-to-next-label peephole and dead-temp elimination.
// Operates on the PIR structures defined in `selfhost/ir.सूत्र`.
// Differential oracle: peacock/compiler/selfhost_optimizer.py
प्रकरण selfhost_optimizer
उपयोग पाठ्य;

// ---------------------------------------------------------------------------
// Reuse IR model (duplicated for standalone kernel; must match ir.सूत्र)
// ---------------------------------------------------------------------------
संघटन IRInstr {
    op: अक्षरमाला,
    dest: पूर्णाङ्क,
    arg0: अक्षरमाला,
    arg1: अक्षरमाला,
    arg2: अक्षरमाला,
    dest_type_key: अक्षरमाला,
    chihna: अक्षरमाला
}
संघटन IRFunction {
    नाम: अक्षरमाला,
    slot_count: पूर्णाङ्क,
    return_type_key: अक्षरमाला,
    instrs: सूची<IRInstr>
}
संघटन IRModule {
    नाम: अक्षरमाला,
    functions: सूची<IRFunction>,
    uses: सूची<अक्षरमाला>,
    struct_descs: सूची<अक्षरमाला>
}
संघटन OptStats {
    constants_folded: पूर्णाङ्क,
    branches_folded: पूर्णाङ्क,
    unreachable_removed: पूर्णाङ्क,
    jumps_removed: पूर्णाङ्क,
    labels_removed: पूर्णाङ्क,
    dead_temps_removed: पूर्णाङ्क
}

// ---------------------------------------------------------------------------
// Helpers for literal handling
// ---------------------------------------------------------------------------
कार्य is_digit_string(s: अक्षरमाला) -> सत्यता {
    यदि दैर्घ्य(s) == ० { प्रत्यानय असत्य; }
    स्थापय परिवर्तनीय i = ०;
    यदि पाठ्य.अक्षरम्(s, ०) == "-" { i = १; यदि दैर्घ्य(s) == १ { प्रत्यानय असत्य; } }
    यावत् i < दैर्घ्य(s) {
        यदि न पाठ्य.अङ्कः(पाठ्य.अक्षरम्(s, i)) { प्रत्यानय असत्य; }
        i += १;
    }
    प्रत्यानय सत्य;
}
कार्य is_bool_repr(s: अक्षरमाला) -> सत्यता { प्रत्यानय s == "true" वा s == "false" वा s == "सत्य" वा s == "असत्य"; }
कार्य parse_bool(s: अक्षरमाला) -> सत्यता { प्रत्यानय s == "true" वा s == "सत्य"; }
कार्य bool_repr(b: सत्यता) -> अक्षरमाला { यदि b { प्रत्यानय "true"; } प्रत्यानय "false"; }

कार्य string_to_int(s: अक्षरमाला) -> पूर्णाङ्क {
    // assumes is_digit_string true, handles leading -
    स्थापय परिवर्तनीय neg = असत्य;
    स्थापय परिवर्तनीय आरम्भ = ०;
    यदि पाठ्य.अक्षरम्(s, ०) == "-" { neg = सत्य; आरम्भ = १; }
    स्थापय परिवर्तनीय v = ०;
    स्थापय परिवर्तनीय i = आरम्भ;
    यावत् i < दैर्घ्य(s) {
        स्थापय d = पाठ्य.अक्षरसङ्ख्या(पाठ्य.अक्षरम्(s, i)) - पाठ्य.अक्षरसङ्ख्या("0");
        v = v * १० + d;
        i += १;
    }
    यदि neg { v = -v; }
    प्रत्यानय v;
}
कार्य int_ok(v: पूर्णाङ्क) -> सत्यता {
    // INT64 bounds check: -(2^63) .. 2^63-1
    // Compute bounds via incremental to avoid literal overflow in PEACOCK int?
    // Use known constants: -9223372036854775808 .. 9223372036854775807
    // PEACOCK पूर्णाङ्क is 64-bit; literal fits.
    // Use max = 9223372036854775807, min = -max -1
    स्थापय परिवर्तनीय maxv = ९२२३३७२०३६८५४७७५८०७;
    यदि v > maxv { प्रत्यानय असत्य; }
    यदि v < -maxv - १ { प्रत्यानय असत्य; }
    प्रत्यानय सत्य;
}
कार्य fold_binop(op: अक्षरमाला, a_repr: अक्षरमाला, b_repr: अक्षरमाला, a_is_int: सत्यता, b_is_int: सत्यता) -> अक्षरमाला {
    // Returns folded repr or "" if not foldable. Handles int ops and string + and comparisons.
    // For int case, both must be digit strings.
    यदि op == "+" तथा a_is_int तथा b_is_int {
        स्थापय av = string_to_int(a_repr);
        स्थापय bv = string_to_int(b_repr);
        स्थापय परिवर्तनीय rv = av + bv;
        यदि न int_ok(rv) { प्रत्यानय ""; }
        प्रत्यानय पाठ्यीकरण(rv);
    }
    यदि op == "-" तथा a_is_int तथा b_is_int {
        स्थापय av = string_to_int(a_repr);
        स्थापय bv = string_to_int(b_repr);
        स्थापय परिवर्तनीय rv = av - bv;
        यदि न int_ok(rv) { प्रत्यानय ""; }
        प्रत्यानय पाठ्यीकरण(rv);
    }
    यदि op == "*" तथा a_is_int तथा b_is_int {
        स्थापय av = string_to_int(a_repr);
        स्थापय bv = string_to_int(b_repr);
        स्थापय परिवर्तनीय rv = av * bv;
        यदि न int_ok(rv) { प्रत्यानय ""; }
        प्रत्यानय पाठ्यीकरण(rv);
    }
    यदि op == "/" तथा a_is_int तथा b_is_int {
        स्थापय av = string_to_int(a_repr);
        स्थापय bv = string_to_int(b_repr);
        यदि bv == ० { प्रत्यानय ""; }
        स्थापय परिवर्तनीय q = ०;
        // abs division trunc toward zero
        स्थापय परिवर्तनीय abs_a = av; यदि abs_a < ० { abs_a = -abs_a; }
        स्थापय परिवर्तनीय abs_b = bv; यदि abs_b < ० { abs_b = -abs_b; }
        q = abs_a / abs_b;
        // integer division for positive; PEACOCK / on ints is trunc
        यदि (av < ०) != (bv < ०) { q = -q; }
        यदि न int_ok(q) { प्रत्यानय ""; }
        प्रत्यानय पाठ्यीकरण(q);
    }
    यदि op == "%" तथा a_is_int तथा b_is_int {
        स्थापय av = string_to_int(a_repr);
        स्थापय bv = string_to_int(b_repr);
        यदि bv == ० { प्रत्यानय ""; }
        स्थापय परिवर्तनीय abs_a = av; यदि abs_a < ० { abs_a = -abs_a; }
        स्थापय परिवर्तनीय abs_b = bv; यदि abs_b < ० { abs_b = -abs_b; }
        स्थापय परिवर्तनीय q = abs_a / abs_b;
        यदि (av < ०) != (bv < ०) { q = -q; }
        स्थापय परिवर्तनीय rv = av - q * bv;
        यदि न int_ok(rv) { प्रत्यानय ""; }
        प्रत्यानय पाठ्यीकरण(rv);
    }
    यदि op == "**" तथा a_is_int तथा b_is_int {
        स्थापय av = string_to_int(a_repr);
        स्थापय bv = string_to_int(b_repr);
        यदि bv < ० वा bv > ६३ { प्रत्यानय ""; }
        स्थापय परिवर्तनीय rv = १;
        स्थापय परिवर्तनीय i = ०;
        यावत् i < bv {
            rv = rv * av;
            यदि न int_ok(rv) { प्रत्यानय ""; }
            i += १;
        }
        प्रत्यानय पाठ्यीकरण(rv);
    }
    यदि op == "+" {
        प्रत्यानय a_repr + b_repr;
    }
    // comparisons for ints / bools / strings (exact type same handled by caller)
    प्रत्यानय "";
}

