// PEACOCK-native IR kernel (migration stage 4).
//
// This file is executed by PEACOCK itself. It implements the flat,
// typed, three-address PEACOCK Intermediate Representation (PIR) that
// the Python bootstrap defines in `peacock/compiler/ir.py`.
//
// PIR uses numbered slots for named locals and virtual registers for
// expression temporaries (reg = slot_count .. next_reg-1). Control flow
// is expressed with chihna_samooha, conditional branches and jumps. Values that
// must cross a join are kept in slots.
//
// This kernel does not parse source. `compile_source(..., semantic_mode=\"ir_shadow\")`
// (future: implemented in `peacock/compiler/selfhost_ir.py`) translates a
// TypedProgram into a sequence of builder calls executed here, and the
// resulting IR digest is compared with the Python oracle. This file is
// therefore an executable specification of the IR instruction set and
// builder, not a replacement compiler.

प्रकरण selfhost_ir

// ---------------------------------------------------------------------------
// IR model
// ---------------------------------------------------------------------------

संघटन IRInstr {
    op: अक्षरमाला,
    dest: पूर्णाङ्क,
    arg0: अक्षरमाला,
    arg1: अक्षरमाला,
    arg2: अक्षरमाला,
    dest_type_key: अक्षरमाला,
    chihna: अक्षरमाला
}

संघटन IRFunction {
    नाम: अक्षरमाला,
    slot_count: पूर्णाङ्क,
    return_type_key: अक्षरमाला,
    instrs: सूची<IRInstr>
}

संघटन IRModule {
    नाम: अक्षरमाला,
    functions: सूची<IRFunction>,
    uses: सूची<अक्षरमाला>,
    struct_descs: सूची<अक्षरमाला>
}

संघटन IRBuilder {
    नाम: अक्षरमाला,
    slot_count: पूर्णाङ्क,
    return_type_key: अक्षरमाला,
    next_reg: पूर्णाङ्क,
    label_counter: पूर्णाङ्क,
    instrs: सूची<IRInstr>,
    break_targets: सूची<अक्षरमाला>,
    continue_targets: सूची<अक्षरमाला>
}

// ---------------------------------------------------------------------------
// Constructors
// ---------------------------------------------------------------------------

कार्य new_module(नाम: अक्षरमाला) -> IRModule {
    प्रत्यानय IRModule(नाम, [], [], []);
}

कार्य module_add_function(mod: IRModule, kary: IRFunction) {
    mod.functions.योजय(kary);
}

कार्य module_add_use(mod: IRModule, cap: अक्षरमाला) {
    mod.uses.योजय(cap);
}

कार्य module_add_struct(mod: IRModule, struct_desc: अक्षरमाला) {
    mod.struct_descs.योजय(struct_desc);
}

कार्य new_builder(नाम: अक्षरमाला, slot_count: पूर्णाङ्क, return_type_key: अक्षरमाला) -> IRBuilder {
    प्रत्यानय IRBuilder(नाम, slot_count, return_type_key, slot_count, ०, [], [], []);
}

कार्य builder_finish(builder: IRBuilder) -> IRFunction {
    // Mirror Python's `build()`: if the last instruction is not already a
    // terminal (return/throw/jump) emit an implicit void return. The builder
    // itself is also responsible for the `return` that the Python builder
    // always appends; callers that have emitted an explicit return therefore
    // see a single terminal, matching Python behaviour on the shadow corpus.
    यदि दैर्घ्य(builder.instrs) == ० {
        builder.instrs.योजय(IRInstr("return", -१, "null", "", "", "", ""));
    } अन्यथा {
        स्थापय last = builder.instrs.प्राप्नु(दैर्घ्य(builder.instrs) - १);
        यदि last.op != "return" तथा last.op != "throw" तथा last.op != "jump" {
            builder.instrs.योजय(IRInstr("return", -१, "null", "", "", "", ""));
        }
    }
    प्रत्यानय IRFunction(builder.नाम, builder.next_reg, builder.return_type_key, builder.instrs);
}

// ---------------------------------------------------------------------------
// Allocation helpers
// ---------------------------------------------------------------------------

कार्य new_reg(builder: IRBuilder) -> पूर्णाङ्क {
    स्थापय r = builder.next_reg;
    builder.next_reg += १;
    प्रत्यानय r;
}

कार्य new_label(builder: IRBuilder, prefix: अक्षरमाला) -> अक्षरमाला {
    builder.label_counter += १;
    प्रत्यानय prefix + पाठ्यीकरण(builder.label_counter);
}

// ---------------------------------------------------------------------------
// Low-level emit (single place that materialises an IRInstr)
// ---------------------------------------------------------------------------

कार्य emit_raw(builder: IRBuilder, op: अक्षरमाला, dest: पूर्णाङ्क, arg0: अक्षरमाला, arg1: अक्षरमाला, arg2: अक्षरमाला, dest_type_key: अक्षरमाला, chihna: अक्षरमाला) -> पूर्णाङ्क {
    यदि dest >= ० तथा dest >= builder.next_reg {
        builder.next_reg = dest + १;
    }
    builder.instrs.योजय(IRInstr(op, dest, arg0, arg1, arg2, dest_type_key, chihna));
    प्रत्यानय dest;
}

