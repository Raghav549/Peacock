कार्य emit_call(builder: IRBuilder, dest: पूर्णाङ्क, callee: अक्षरमाला, arg_regs: सूची<पूर्णाङ्क>, type_key: अक्षरमाला) -> पूर्णाङ्क {
    स्थापय परिवर्तनीय joined = "";
    स्थापय परिवर्तनीय i = ०;
    यावत् i < दैर्घ्य(arg_regs) {
        यदि i > ० {
            joined = joined + ",";
        }
        joined = joined + पाठ्यीकरण(arg_regs.प्राप्नु(i));
        i += १;
    }
    प्रत्यानय emit_raw(builder, "call", dest, callee, joined, "", type_key, "");
}

