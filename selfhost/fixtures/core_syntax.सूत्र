// Core-syntax fixture for the self-hosted parser parity test.
प्रकरण core_syntax

संघटन Pair {
    अ: पूर्णाङ्क
    ब: अक्षरमाला
}

कार्य classify(n: पूर्णाङ्क) -> अक्षरमाला {
    यदि n < ० {
        प्रत्यानय "negative";
    } अन्यथा यदि n == ० {
        प्रत्यानय "zero";
    }
    प्रत्यानय "positive";
}

कार्य मुख्य() -> एकक {
    स्थापय परिवर्तनीय values: सूची<पूर्णाङ्क> = [१, २, ३];
    values.योजय(४);
    स्थापय first = values[०];
    स्थापय pair = Pair(२, "two");

    स्थापय परिवर्तनीय i = ०;
    यावत् i < १० {
        i += १;
        यदि i % २ == ० {
            अनुवर्तय;
        }
        यदि i > ७ {
            विच्छिन्दु;
        }
    }

    स्थापय power = २ ** ३ ** २;
    स्थापय negated = -power;
    स्थापय flag = न (negated == ०) तथा सत्य वा असत्य;

    स्थापय परिवर्तनीय range_total = ०;
    प्रति n मध्ये १..४ {
        range_total += n;
    }

    {
        स्थापय nested = "block";
        मुद्रय(nested);
    }

    निश्चिनु range_total == ६;
    मुद्रय(classify(-१) + " " + classify(०) + " " + classify(१));
    मुद्रय(पाठ्यीकरण(first) + " " + pair.ब + " " + पाठ्यीकरण(flag));
    यदि सत्य {
        मुद्रय("done");
    } अन्यथा {
        मुद्रय("nope");
    }
}
