// Differentiable tensors and a gradient check.
प्रकरण tensor_sample

उपयोग तन्त्रजाल

कार्य मुख्य() -> एकक {
    अधिकार गणना;
    स्थापय क्ष = आयामीकरण([[१.०, २.०], [३.०, ४.०]]);
    स्थापय w = तन्त्रजाल.प्राचल([[०.१, -०.२], [०.३, ०.४]]);
    स्थापय लक्ष्य = आयामीकरण([[१.०, ०.०], [०.०, १.०]]);
    स्थापय दोष = तन्त्रजाल.माध्यवर्गदोष(क्ष.आव्यूहगुणन(w), लक्ष्य);
    दोष.पश्चप्रसार();
    मुद्रय("loss: " + पाठ्यीकरण(दोष.अवयव()));
    मुद्रय("gradient: " + पाठ्यीकरण(w.अवकल));
}
