// Perceptual colour: conversion, contrast and mixing.
प्रकरण colour_sample

उपयोग रङ्ग

कार्य मुख्य() -> एकक {
    स्थापय violet = रङ्ग.ओकएलसीएच(०.६२, ०.१९, ३००.०);
    स्थापय teal = रङ्ग.एसआरजीबी(०.०५, ०.५५, ०.५५);
    मुद्रय("violet: " + रङ्ग.शैलीपाठ्य(violet));
    मुद्रय("contrast: " + पाठ्यीकरण(रङ्ग.विरोधद्युति(violet, teal)));
    मुद्रय("mixed: " + रङ्ग.शैलीपाठ्य(रङ्ग.मिश्रय(violet, teal, ०.५)));
    मुद्रय("lightened: " + रङ्ग.शैलीपाठ्य(रङ्ग.दीप्तय(violet, ०.२)));
}
