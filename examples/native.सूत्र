// Compile to a standalone native executable with `peacock native`.
प्रकरण native_demo

कार्य द्विगुण(मान: पूर्णाङ्क) -> पूर्णाङ्क {
    प्रत्यानय मान * २;
}

कार्य मुख्य() -> एकक {
    स्थापय परिवर्तनीय योग = ०;
    प्रति अंश मध्ये ०..६ {
        योग = योग + द्विगुण(अंश);
    }
    स्थापय मानानि = [३, १, २];
    मानानि.योजय(योग);
    मानानि.क्रमय();
    निश्चिनु योग == ३०;
    निश्चिनु मानानि[३] == ३०;
    निश्चिनु दैर्घ्य("संस्कृतम्") == ९;
    मुद्रय("native total: " + पाठ्यीकरण(योग));
    मुद्रय("native list: " + पाठ्यीकरण(मानानि));
    मुद्रय("स्वतन्त्रम्");
}
