// Build, lay out, audit and export a responsive Sanskrit UI without JavaScript.
// Run: ./bin/peacock run examples/ui_builder.सूत्र --grant सञ्चय --root .
प्रकरण ui_builder_demo

उपयोग रङ्ग
उपयोग दृश्य

कार्य मुख्य() -> एकक {
    अधिकार सञ्चय;
    स्थापय पृष्ठ = रङ्ग.षोडशात्("#102030");
    स्थापय अग्र = रङ्ग.षोडशात्("#ffffff");
    स्थापय प्रभा = रङ्ग.षोडशात्("#007777");
    स्थापय रचना = दृश्य.सृज("मयूर दृश्य", ६४०, ३६०, पृष्ठ);
    स्थापय पटल = दृश्य.पटल(रचना, ०, २०.०, २०.०, ६००.०, ३२०.०, पृष्ठ);
    दृश्य.पाठ्य(रचना, पटल, "संस्कृतं स्वाभाविकम्", ०.०, ०.०, ५६०.०, ६४.०, अग्र, २८.०);
    स्थापय नोदक = दृश्य.नोदक(रचना, पटल, "आरभ्यताम्", ०.०, ०.०, २२०.०, ५२.०, प्रभा, अग्र);
    दृश्य.प्रवाह(रचना, पटल, "स्तम्भ", १६.०, २०.०);
    निश्चिनु दृश्य.स्पर्शपरीक्षा(रचना, ५०.०, १३०.०) == नोदक;
    निश्चिनु दैर्घ्य(दृश्य.अन्वीक्षा(रचना)) == ०;
    दृश्य.रक्ष(रचना, "examples/out/ui.html");
    मुद्रय("UI nodes: " + पाठ्यीकरण(दृश्य.ग्रन्थिसंख्या(रचना)));
}
