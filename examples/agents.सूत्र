// A deterministic production-rule agent with minimum-cost planning.
प्रकरण agent_demo

उपयोग अभिकर्तृ

कार्य मुख्य() -> एकक {
    अधिकार गणना;
    स्थापय कर्ता = अभिकर्तृ.सृज("स्थिति", "गृहम्", ८);
    अभिकर्तृ.तथ्य(कर्ता, "स्थिति", "बाह्यम्");
    अभिकर्तृ.नियम(कर्ता, "स्थिति", "बाह्यम्", "द्वारं गच्छ", "स्थिति", "द्वारम्", ५.०, २.०);
    अभिकर्तृ.नियम(कर्ता, "स्थिति", "द्वारम्", "गृहं प्रविश", "स्थिति", "गृहम्", ५.०, १.०);
    अभिकर्तृ.नियम(कर्ता, "स्थिति", "बाह्यम्", "उपवनं गच्छ", "स्थिति", "उपवनम्", ९.०, १०.०);
    स्थापय योजना = अभिकर्तृ.योजना(कर्ता);
    निश्चिनु दैर्घ्य(योजना) == २;
    मुद्रय("plan: " + योजना.संयोजय(" → "));
    स्थापय क्रिया = अभिकर्तृ.चलाय(कर्ता);
    निश्चिनु दैर्घ्य(क्रिया) == २;
    निश्चिनु अभिकर्तृ.प्राप्नु(कर्ता, "स्थिति") == "गृहम्";
    निश्चिनु अभिकर्तृ.स्थिति(कर्ता) == "सिद्ध";
    मुद्रय(अभिकर्तृ.अनुसरण(कर्ता).संयोजय("\n"));
}
