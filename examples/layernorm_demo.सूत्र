प्रकरण layernorm_demo

// LayerNorm (सामान्यीकरण) is now available in the Python engine as a
// foundation for transformer architectures.  This example still uses the
// stable Dense (सघन) stack so it remains compatible with the self-hosted
// type-checker while the DSL form सामान्यीकरण(सामान्यमान: N) is being
// promoted through the pipeline.  See tests/ai/test_layernorm.py for the
// full Python API demo: Dense → LayerNorm → Dense with autodiff.

उपयोग तन्त्रजाल

प्रतिमान NormNet {
    निवेश क्ष: आयाम<दशमलव३२, [२]>
    निर्गम य: आयाम<दशमलव३२, [२]>
    क्रम {
        सघन(एककानि: ८, सक्रियण: धनाङ्क)
        सघन(एककानि: ८, सक्रियण: रैखिक)
        सघन(एककानि: २)
    }
}

अभ्यास NormTraining {
    उद्देश्य: "अन्तरएन्ट्रॉपी"
    अनुकूलक: "आदम"
    आवृत्ति: १००
    अधिगमदर: ०.०५
    समूहमान: ४
    बीज: ७
}

कार्य मुख्य() -> एकक {
    अधिकार गणना;
    स्थापय दत्त = तन्त्रजाल.असमानयोग();
    स्थापय net = NormNet.प्रारम्भ(बीज: ७);
    स्थापय losses = NormTraining.चलाय(net, दत्त);
    स्थापय शुद्धता = NormTraining.मूल्याङ्कय(net, दत्त);
    मुद्रय("layers: 3 (Dense → Dense → Dense) + Python LayerNorm in tests/ai/test_layernorm.py");
    मुद्रय("epochs: " + पाठ्यीकरण(दैर्घ्य(losses)));
    मुद्रय("final loss: " + पाठ्यीकरण(तन्त्रजाल.दोष(net, दत्त, दोष: "अन्तरएन्ट्रॉपी")));
    मुद्रय("accuracy: " + पाठ्यीकरण(शुद्धता));
    निश्चिनु(शुद्धता >= ०.७५);
    मुद्रय("सामान्यीकरणं सिद्धम् — see Python API");
}
