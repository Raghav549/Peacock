// Interactive counter: run with --grant दृश्य --ui-serve 8080 and click once.
प्रकरण ui_events_demo

उपयोग रङ्ग
उपयोग दृश्य

कार्य मुख्य() -> एकक {
    अधिकार दृश्य;
    स्थापय पृष्ठ = रङ्ग.षोडशात्("#102030");
    स्थापय अग्र = रङ्ग.षोडशात्("#ffffff");
    स्थापय प्रभा = रङ्ग.षोडशात्("#007777");
    स्थापय रचना = दृश्य.सृज("घटनासहित मयूर", ३६०, २४०, पृष्ठ);
    स्थापय पटल = दृश्य.पटल(रचना, ०, १०.०, १०.०, ३४०.०, २२०.०, पृष्ठ);
    स्थापय पाठ्य = दृश्य.पाठ्य(रचना, पटल, "क्लिक: ०", २०.०, १५.०, ३००.०, ६४.०, अग्र, २६.०);
    स्थापय नोदक = दृश्य.नोदक(रचना, पटल, "एकं योजयतु", २०.०, ९५.०, २२०.०, ५६.०, प्रभा, अग्र);
    दृश्य.बन्धन(रचना, नोदक, "स्पर्श", "वृद्धि");
    दृश्य.प्रदर्शय(रचना);
    स्थापय घटना = दृश्य.अग्रघटना(रचना, ३००००);
    यदि दैर्घ्य(घटना) == ० {
        क्षिप "no UI event arrived before the timeout";
    }
    निश्चिनु घटना[१] == "स्पर्श";
    निश्चिनु घटना[२] == पाठ्यीकरण(नोदक);
    निश्चिनु घटना[८] == "वृद्धि";
    दृश्य.पाठ्यस्थापय(रचना, पाठ्य, "क्लिक: १");
    दृश्य.प्रदर्शय(रचना);
    मुद्रय("UI event: " + घटना[१] + " / " + घटना[८]);
}
