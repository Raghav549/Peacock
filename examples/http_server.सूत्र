// Run: ./bin/peacock run examples/http_server.सूत्र --grant सञ्जाल
// Then POST UTF-8 text to the printed 127.0.0.1 port. One request is served.
प्रकरण http_server_demo

उपयोग सेवक

कार्य मुख्य() -> एकक {
    अधिकार सञ्जाल;
    स्थापय स = सेवक.श्रृणु("127.0.0.1", ०);
    मुद्रय("port: " + पाठ्यीकरण(सेवक.द्वार(स)));
    स्थापय निवेदन = सेवक.स्वीकुरु(स, ६००००);
    यदि दैर्घ्य(निवेदन) == ० {
        सेवक.पिदध्मि(स);
        मुद्रय("accept timeout");
        प्रत्यानय;
    }
    मुद्रय("request: " + निवेदन[१] + " " + निवेदन[२]);
    स्थापय उत्तर = "PEACOCK सेवक\nmethod: " + निवेदन[१] + "\nbody: " + निवेदन[४] + "\n";
    सेवक.प्रत्युत्तरय(स, निवेदन[०], २००, उत्तर);
    सेवक.पिदध्मि(स);
}
