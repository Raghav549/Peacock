// Render actual 3-D meshes with perspective, point lights and a depth buffer.
// Run: ./bin/peacock run examples/scene3d.सूत्र --grant सञ्चय --root .
प्रकरण scene3d_demo

उपयोग रङ्ग
उपयोग चित्र
उपयोग त्रिअयाम

कार्य मुख्य() -> एकक {
    अधिकार सञ्चय;
    स्थापय दृश्य = त्रिअयाम.सृज();
    स्थापय घन = त्रिअयाम.घन(दृश्य, -०.९, ०.०, ०.०, १.२, रङ्ग.षोडशात्("#ff7040"));
    त्रिअयाम.भ्रमय(दृश्य, घन, २०.०, ३०.०, १०.०);
    त्रिअयाम.गोलक(दृश्य, ०.९, ०.०, ०.२, ०.८, रङ्ग.षोडशात्("#40c0ff"), २४, १२);
    त्रिअयाम.प्रकाश(दृश्य, २.०, ३.०, ४.०, रङ्ग.षोडशात्("#ffffff"), २.०);
    निश्चिनु त्रिअयाम.त्रिभुजसंख्या(दृश्य) == ५८८;
    स्थापय पट = चित्र.चित्रपट्ट(३२०, २००);
    चित्र.पूरय(पट, रङ्ग.षोडशात्("#101820"));
    त्रिअयाम.अङ्कन(दृश्य, पट, १५.०, १०.०, ५.०, ४५.०);
    चित्र.रक्ष(पट, "examples/out/scene3d.png");
    मुद्रय("3D triangles: " + पाठ्यीकरण(त्रिअयाम.त्रिभुजसंख्या(दृश्य)));
}
