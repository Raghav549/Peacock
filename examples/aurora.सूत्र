// Deterministic procedural colour: render an aurora to a real PNG.
प्रकरण उषोद्युति

उपयोग रङ्ग
उपयोग चित्र

कार्य मुख्य() -> एकक {
    अधिकार सञ्चय;
    स्थापय चित्रपट्ट = चित्र.चित्रपट्ट(९६०, ५४०);
    स्थापय वर्णावली = [
        रङ्ग.ओकएलसीएच(०.५५, ०.१८, १६०.०),
        रङ्ग.ओकएलसीएच(०.७२, ०.२०, २८५.०),
        रङ्ग.ओकएलसीएच(०.६२, ०.१६, ६०.०)
    ];
    चित्र.वर्णक्रम(चित्रपट्ट, वर्णावली, ३५.०);
    चित्र.उषोद्युति(चित्रपट्ट, १.५, ४२);
    चित्र.रक्ष(चित्रपट्ट, "examples/out/aurora.png");
    मुद्रय("wrote examples/out/aurora.png");
}
