// CPU reference is always available. Replace क्रमक with त्वरक to require
// an actual OpenCL GPU/accelerator; unavailability is then a PE6002 fault.
प्रकरण gpu_demo

उपयोग गणनयन्त्र

कार्य मुख्य() -> एकक {
    अधिकार गणना;
    स्थापय अ = आयामीकरण([[१.०, २.०], [३.०, ४.०]]);
    स्थापय ब = आयामीकरण([[५.०, ६.०], [७.०, ८.०]]);
    स्थापय योग = गणनयन्त्र.संकलय("क्रमक", अ, ब);
    स्थापय गुणन = गणनयन्त्र.आव्यूहगुणन("क्रमक", अ, ब);
    मुद्रय("sum: " + पाठ्यीकरण(योग));
    मुद्रय("matmul: " + पाठ्यीकरण(गुणन));
    प्रति विवरण मध्ये गणनयन्त्र.विवरण("स्वयम्") {
        मुद्रय(विवरण);
    }
}
