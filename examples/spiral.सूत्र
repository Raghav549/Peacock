// Train a small classifier on a synthetic two-arm spiral.
प्रकरण spiral_net

उपयोग तन्त्रजाल

प्रतिमान SpiralNet {
    निवेश विशेषक: आयाम<दशमलव३२, [२]>
    निर्गम scores: आयाम<दशमलव३२, [२]>
    क्रम {
        सघन(एककानि: २४, सक्रियण: धनाङ्क)
        सघन(एककानि: २४, सक्रियण: धनाङ्क)
        सघन(एककानि: २)
    }
}

अभ्यास SpiralTraining {
    उद्देश्य: "अन्तरएन्ट्रॉपी"
    अनुकूलक: "आदम"
    आवृत्ति: २५०
    अधिगमदर: ०.०२
    समूहमान: १६
    बीज: ३
}

कार्य मुख्य() -> एकक {
    अधिकार गणना;

    स्थापय दत्त = तन्त्रजाल.सर्पिल(२४, ०.१, ३);
    स्थापय net = SpiralNet.प्रारम्भ(बीज: ३);
    मुद्रय("samples: " + पाठ्यीकरण(दत्त.मान));
    स्थापय losses = SpiralTraining.चलाय(net, दत्त);
    मुद्रय("epochs: " + पाठ्यीकरण(दैर्घ्य(losses)));
    मुद्रय("final loss: " + पाठ्यीकरण(तन्त्रजाल.दोष(net, दत्त, दोष: "अन्तरएन्ट्रॉपी")));
    मुद्रय("accuracy: " + पाठ्यीकरण(SpiralTraining.मूल्याङ्कय(net, दत्त)));
}
