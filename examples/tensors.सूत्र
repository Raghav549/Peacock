// Differentiable computation in PEACOCK: matmul, loss, reverse-mode gradients.
प्रकरण tensors

उपयोग तन्त्रजाल

कार्य मुख्य() -> एकक {
    अधिकार गणना;

    स्थापय क्ष = आयामीकरण([[१.०, २.०], [३.०, ४.०]]);
    स्थापय column = आयामीकरण([[०.५], [१.५]]);
    स्थापय projected = क्ष.आव्यूहगुणन(column);
    मुद्रय("matmul: " + पाठ्यीकरण(projected));
    मुद्रय("shape: " + पाठ्यीकरण(projected.आकृति));
    मुद्रय("softmax: " + पाठ्यीकरण(आयामीकरण([[१.०, २.०, ३.०]]).कोमलाधिकतम()));

    स्थापय weights = तन्त्रजाल.प्राचल([[०.१, -०.२], [०.३, ०.४]]);
    स्थापय लक्ष्याणि = आयामीकरण([[१.०, ०.०], [०.०, १.०]]);
    स्थापय पूर्वानुमानानि = क्ष.आव्यूहगुणन(weights);
    स्थापय दोष = तन्त्रजाल.माध्यवर्गदोष(पूर्वानुमानानि, लक्ष्याणि);
    मुद्रय("loss: " + पाठ्यीकरण(दोष.अवयव()));
    दोष.पश्चप्रसार();
    मुद्रय("weight gradient: " + पाठ्यीकरण(weights.अवकल));

    // Analytic check: for mean-squared error, dL/dW = X^T * (2/N) * (P - T).
    स्थापय expected = क्ष.परिवर्त().आव्यूहगुणन((पूर्वानुमानानि - लक्ष्याणि) * ०.५);
    मुद्रय("autodiff gradient: " + पाठ्यीकरण(weights.अवकल));
    मुद्रय("closed-form gradient: " + पाठ्यीकरण(expected));
    मुद्रय("max abs difference: " + पाठ्यीकरण(तन्त्रजाल.अधिकतमनिरपेक्षान्तर(weights.अवकल, expected)));
}
