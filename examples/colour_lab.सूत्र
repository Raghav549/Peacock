// Perceptual, linear and approximate pigment colour operations.
प्रकरण colour_lab

उपयोग रङ्ग

कार्य मुख्य() -> एकक {
    स्थापय रक्त = रङ्ग.षोडशात्("#ff0000");
    स्थापय नील = रङ्ग.षोडशात्("#0000ff");
    स्थापय वर्ण = [रक्त, नील];
    स्थापय भार = [१.०, ३.०];
    स्थापय मिश्र = रङ्ग.बहुमिश्रय(वर्ण, भार, "ओकलैब");
    स्थापय वर्णक = रङ्ग.बहुमिश्रय(वर्ण, भार, "व्यवकलन");
    मुद्रय("oklab: " + रङ्ग.शैलीपाठ्य(मिश्र));
    मुद्रय("subtractive: " + रङ्ग.शैलीपाठ्य(वर्णक));
    निश्चिनु रङ्ग.वर्णान्तर(रक्त, रक्त) == ०.०;
    स्थापय विस्तृत = रङ्ग.ओकएलसीएच(०.७, ०.५, ३०.०);
    स्थापय सीमित = रङ्ग.वर्णक्षेत्रीकरण(विस्तृत);
    मुद्रय("gamut: " + रङ्ग.शैलीपाठ्य(सीमित));
}
